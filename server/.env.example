NODE_ENV=development
HOST=0.0.0.0
PORT=4001
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nora_premium_tex?sslmode=require
DATABASE_POOL_SIZE=10
CORS_ORIGINS=http://localhost:4000
ASSETS_PUBLIC_URL=http://localhost:4000
INTERNAL_API_KEY=replace-with-the-same-key-as-the-storefront

# Cloudflare R2 (required only for upload/migration jobs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nora-premium-tex-assets

# Email notifications
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Nora Premium Tex <notifications@example.com>
NOTIFICATION_TO_EMAIL=bordostudio.tex@gmail.com
STOREFRONT_URL=http://localhost:4000
ADMIN_URL=http://localhost:4000/admin
AUTH_SESSION_DAYS=30
PRIVACY_IP_SALT=replace-with-at-least-16-random-characters
ADMIN_EMAIL=bordo.studio1@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
